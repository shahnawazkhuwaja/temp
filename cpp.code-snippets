      "",
      "    print_constraint_graph()",
      "",
      "    print(\"\\n(e) Running Backtracking Search …\\n\" + \"-\" * 40)",
      "    solution = backtrack({}, variables, domains)",
      "    print(\"-\" * 40)",
      "",
      "    if solution:",
      "        print(\"\\n✓ Valid schedule found!\\n\")",
      "        sorted_sched = sorted(solution.items(), key=lambda x: x[1])",
      "        print(f\"  {'Time Slot':<30}  Presentation\")",
      "        print(f\"  {'─'*28}  {'─'*20}\")",
      "        for var, slot in sorted_sched:",
      "            print(f\"  {slot_names[slot]:<30}  {var}\")",
      "",
      "        print(\"\\n  Constraint verification:\")",
      "        for i, (c, label) in enumerate(zip(constraints, constraint_labels), 1):",
      "            status = \"✓ PASS\" if c(solution) else \"✗ FAIL\"",
      "            print(f\"    {status}  {label}\")",
      "    else:",
      "        print(\"  ✗ No valid assignment found.\")",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
