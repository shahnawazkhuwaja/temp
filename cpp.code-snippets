  "Task 1 - CSP Developer Module Assignment": {
    "prefix": "sirTask1-csp-developer",
    "body": [
      "from itertools import permutations",
      "",
      "MODULE_NAMES = {0: 'AI', 1: 'Web', 2: 'Mobile', 3: 'Cloud', 4: 'Security', 5: 'Testing'}",
      "DEVELOPERS   = ['D1', 'D2', 'D3', 'D4', 'D5', 'D6']",
      "",
      "# Forbidden: (developer_index, module_index)",
      "# D1 cannot do Security or Testing",
      "# D2 cannot do AI",
      "# D5 can only do Web or Mobile",
      "# D6 cannot do AI or Cloud",
      "FORBIDDEN = {",
      "    (0, 4), (0, 5),",
      "    (1, 0),",
      "    (4, 0), (4, 1), (4, 2), (4, 3), (4, 5),",
      "    (5, 0), (5, 3),",
      "}",
      "",
      "# Conditional: D3 on AI => D4 must be on Cloud",
      "# Conditional: D1 on Web => D2 cannot be on Mobile",
      "def check_conditional_constraints(assignment):",
      "    if assignment[2] == 0 and assignment[3] != 3:",
      "        return False, 'Violated: D3 on AI requires D4 on Cloud'",
      "    if assignment[0] == 1 and assignment[1] == 2:",
      "        return False, 'Violated: D1 on Web means D2 cannot be on Mobile'",
      "    return True, 'OK'",
      "",
      "def solve():",
      "    print('=' * 55)",
      "    print('  CSP: Developer-to-Module Assignment Solver')",
      "    print('=' * 55)",
      "    print('\\nConstraints Applied:')",
      "    print('  Forbidden: D1->Security, D1->Testing')",
      "    print('  Forbidden: D2->AI')",
      "    print('  Restricted: D5 can only do Web or Mobile')",
      "    print('  Forbidden: D6->AI, D6->Cloud')",
      "    print('  Conditional: D3 on AI => D4 must be on Cloud')",
      "    print('  Conditional: D1 on Web => D2 cannot be on Mobile')",
      "    print('\\nSearching for valid assignments...\\n')",
      "",
      "    solutions = []",
      "    for perm in permutations(range(6)):",
      "        assignment = list(perm)",
      "        forbidden_violated = False",
      "        for dev_idx, mod_idx in enumerate(assignment):",
      "            if (dev_idx, mod_idx) in FORBIDDEN:",
      "                forbidden_violated = True",
      "                break",
      "        if forbidden_violated:",
      "            continue",
      "        valid, msg = check_conditional_constraints(assignment)",
      "        if not valid:",
      "            continue",
      "        solutions.append(assignment)",
      "",
      "    if not solutions:",
      "        print('No valid assignment found.')",
      "        return",
      "",
      "    print(f'Total valid assignments found: {len(solutions)}\\n')",
      "    print('-' * 55)",
      "    print('First Valid Assignment:')",
      "    print('-' * 55)",
      "    first = solutions[0]",
      "    for dev_idx, mod_idx in enumerate(first):",
      "        print(f'  {DEVELOPERS[dev_idx]:4s}  ->  {MODULE_NAMES[mod_idx]}')",
      "",
      "    print('\\nAll Valid Assignments:')",
      "    print('-' * 55)",
      "    for i, sol in enumerate(solutions, 1):",
      "        assignment_str = ', '.join(",
      "            f'{DEVELOPERS[d]}->{MODULE_NAMES[m]}' for d, m in enumerate(sol)",
      "        )",
      "        print(f'  Solution {i:2d}: {assignment_str}')",
      "",
      "    print('\\nVerification of First Solution:')",
      "    print('-' * 55)",
      "    assert len(set(first)) == 6, 'Uniqueness violated!'",
      "    print('  Uniqueness: each developer assigned exactly one unique module')",
      "    for dev_idx, mod_idx in enumerate(first):",
      "        assert (dev_idx, mod_idx) not in FORBIDDEN, 'Forbidden constraint violated!'",
      "    print('  Forbidden constraints: all satisfied')",
      "    valid, _ = check_conditional_constraints(first)",
      "    assert valid",
      "    print('  Conditional constraints: all satisfied')",
      "    print('\\n  Final assignment is VALID.\\n')",
      "",
      "if __name__ == '__main__':",
      "    solve()"
    ],
    "description": "Task 1 - CSP solver: assign 6 developers to 6 modules with forbidden and conditional constraints"
  },

  "Task 2 - Fitness EDA and KMeans Clustering": {
    "prefix": "sirTask2-fitness-eda-kmeans",
    "body": [
      "import pandas as pd",
      "import numpy as np",
      "import matplotlib.pyplot as plt",
      "import seaborn as sns",
      "import warnings",
      "warnings.filterwarnings('ignore')",
      "from sklearn.cluster import KMeans",
      "from sklearn.preprocessing import StandardScaler",
      "",
      "plt.style.use('bmh')",
      "",
      "# ── 1. LOAD ──────────────────────────────────────────────────",
      "df = pd.read_csv('fitness_data.csv')",
      "print('Raw Data Preview:')",
      "print(df.head())",
      "print(f'Shape: {df.shape}')",
      "print(df.info())",
      "",
      "# ── 2. CLEAN ─────────────────────────────────────────────────",
      "num_cols = ['Steps', 'Workout_Duration', 'Calories_Burned', 'Heart_Rate', 'Sleep_Hours']",
      "print('\\nMissing Values Before Cleaning:')",
      "print(df.isnull().sum())",
      "",
      "for col in num_cols:",
      "    median_val = df[col].median()",
      "    missing = df[col].isnull().sum()",
      "    if missing > 0:",
      "        df[col].fillna(median_val, inplace=True)",
      "        print(f'  Filled {missing} missing in {col} with median={median_val:.2f}')",
      "",
      "# Remove outliers using IQR",
      "before = len(df)",
      "for col in num_cols:",
      "    Q1 = df[col].quantile(0.25)",
      "    Q3 = df[col].quantile(0.75)",
      "    IQR = Q3 - Q1",
      "    df = df[(df[col] >= Q1 - 1.5 * IQR) & (df[col] <= Q3 + 1.5 * IQR)]",
      "after = len(df)",
      "print(f'Outliers removed: {before - after} rows')",
      "df.reset_index(drop=True, inplace=True)",
      "",
      "# ── 3. STATISTICAL SUMMARY ───────────────────────────────────",
      "print('\\nStatistical Summary:')",
      "print(df[num_cols].describe().round(2))",
      "",
      "# ── 4. EDA VISUALIZATIONS ────────────────────────────────────",
      "fig, axes = plt.subplots(2, 3, figsize=(16, 10))",
      "fig.suptitle('Fitness Data - Feature Distributions', fontsize=14, fontweight='bold')",
      "colors = ['steelblue', 'coral', 'mediumseagreen', 'orchid', 'goldenrod']",
      "for i, (col, color) in enumerate(zip(num_cols, colors)):",
      "    ax = axes[i // 3][i % 3]",
      "    sns.histplot(df[col], bins=20, color=color, kde=True, ax=ax)",
      "    ax.set_title(col)",
      "axes[1][2].set_visible(False)",
      "plt.tight_layout()",
      "plt.savefig('fitness_distributions.png', dpi=150, bbox_inches='tight')",
      "plt.close()",
      "",
      "# Correlation heatmap",
      "fig, ax = plt.subplots(figsize=(8, 6))",
      "sns.heatmap(df[num_cols].corr(), annot=True, fmt='.2f', cmap='coolwarm',",
      "            square=True, linewidths=0.5, ax=ax)",
      "ax.set_title('Feature Correlation Heatmap', fontsize=13, fontweight='bold')",
      "plt.tight_layout()",
      "plt.savefig('fitness_correlation.png', dpi=150, bbox_inches='tight')",
      "plt.close()",
      "",
      "# Pairplot",
      "pair_df = df[['Steps', 'Calories_Burned', 'Heart_Rate', 'Sleep_Hours']].copy()",
      "fig = sns.pairplot(pair_df, diag_kind='kde', plot_kws={'alpha': 0.5})",
      "fig.fig.suptitle('Pairplot of Key Features', y=1.02, fontsize=13, fontweight='bold')",
      "plt.savefig('fitness_pairplot.png', dpi=150, bbox_inches='tight')",
      "plt.close()",
      "",
      "# ── 5. ELBOW METHOD ──────────────────────────────────────────",
      "X = df[num_cols].values",
      "scaler = StandardScaler()",
      "X_scaled = scaler.fit_transform(X)",
      "",
      "wcss = []",
      "for k in range(1, 11):",
      "    km = KMeans(n_clusters=k, init='k-means++', random_state=42, n_init=10)",
      "    km.fit(X_scaled)",
      "    wcss.append(km.inertia_)",
      "",
      "plt.figure(figsize=(8, 5))",
      "plt.plot(range(1, 11), wcss, 'bo-', linewidth=2, markersize=6)",
      "plt.title('Elbow Method - Optimal K', fontsize=13, fontweight='bold')",
      "plt.xlabel('Number of Clusters (K)')",
      "plt.ylabel('WCSS')",
      "plt.tight_layout()",
      "plt.savefig('fitness_elbow.png', dpi=150, bbox_inches='tight')",
      "plt.close()",
      "",
      "# ── 6. KMEANS (K=3) ──────────────────────────────────────────",
      "optimal_k = 3",
      "kmeans = KMeans(n_clusters=optimal_k, init='k-means++', random_state=42, n_init=10)",
      "df['Cluster'] = kmeans.fit_predict(X_scaled)",
      "",
      "centers = scaler.inverse_transform(kmeans.cluster_centers_)",
      "centers_df = pd.DataFrame(centers, columns=num_cols)",
      "centers_df.index = [f'Cluster {i}' for i in range(optimal_k)]",
      "print('\\nCluster Centers (original scale):')",
      "print(centers_df.round(2))",
      "print('\\nCluster Sizes:')",
      "print(df['Cluster'].value_counts().sort_index())",
      "",
      "# ── 7. CLUSTER VISUALIZATION ─────────────────────────────────",
      "colors_c = ['#e74c3c', '#2ecc71', '#3498db']",
      "fig, axes = plt.subplots(1, 2, figsize=(14, 5))",
      "for i in range(optimal_k):",
      "    s = df[df['Cluster'] == i]",
      "    axes[0].scatter(s['Steps'], s['Calories_Burned'], c=colors_c[i], label=f'Cluster {i}', s=60, alpha=0.7)",
      "    axes[1].scatter(s['Heart_Rate'], s['Sleep_Hours'], c=colors_c[i], label=f'Cluster {i}', s=60, alpha=0.7)",
      "axes[0].scatter(centers_df['Steps'], centers_df['Calories_Burned'], c='black', s=200, marker='X', label='Centroids')",
      "axes[1].scatter(centers_df['Heart_Rate'], centers_df['Sleep_Hours'], c='black', s=200, marker='X', label='Centroids')",
      "axes[0].set_title('Steps vs Calories Burned')",
      "axes[0].set_xlabel('Steps')",
      "axes[0].set_ylabel('Calories Burned')",
      "axes[0].legend()",
      "axes[1].set_title('Heart Rate vs Sleep Hours')",
      "axes[1].set_xlabel('Heart Rate')",
      "axes[1].set_ylabel('Sleep Hours')",
      "axes[1].legend()",
      "plt.suptitle('K-Means Clustering Results (K=3)', fontsize=13, fontweight='bold')",
      "plt.tight_layout()",
      "plt.savefig('fitness_clusters.png', dpi=150, bbox_inches='tight')",
      "plt.close()",
      "",
      "# ── 8. CLUSTER INTERPRETATION ────────────────────────────────",
      "print('\\nCluster Interpretation:')",
      "for i in range(optimal_k):",
      "    c = centers_df.loc[f'Cluster {i}']",
      "    print(f'\\n  Cluster {i}:')",
      "    print(f'    Steps={c[\"Steps\"]:.0f}, Workout={c[\"Workout_Duration\"]:.0f} min, Calories={c[\"Calories_Burned\"]:.0f}')",
      "    print(f'    Heart Rate={c[\"Heart_Rate\"]:.0f} bpm, Sleep={c[\"Sleep_Hours\"]:.1f} hrs')",
      "    if c['Steps'] > 8000 and c['Calories_Burned'] > 400:",
      "        label = 'HIGH ACTIVITY - very active, high calorie burn'",
      "    elif c['Steps'] < 5000 and c['Sleep_Hours'] > 7:",
      "        label = 'LOW ACTIVITY - sedentary, good sleep'",
      "    else:",
      "        label = 'MODERATE ACTIVITY - average fitness level'",
      "    print(f'    Profile: {label}')",
      "",
      "print('\\nAll plots saved.')"
    ],
    "description": "Task 2 - Fitness data: clean, EDA (distributions/heatmap/pairplot), elbow method, KMeans K=3, cluster visualization and interpretation"
  },

