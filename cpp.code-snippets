  "Q2 Minimax + Alpha-Beta Pruning": {
    "prefix": "q2-minimax",
    "description": "CLO#2  Strategy card game: MIN/MAX players, minimax, alpha-beta pruning trace",
    "scope": "python",
    "body": [
      "# ============================================================",
      "# Q2  Minimax + Alpha-Beta Pruning",
      "# CLO #2: Adversarial Search in a Turn-Based Combat Game",
      "# ============================================================",
      "# AI   = MAX player  (picks strategy card to maximise score)",
      "# Opp  = MIN player  (picks response to minimise AI's score)",
      "# Strategy Cards (leaf values = opponent responses):",
      "#   Card A: 7 or 3",
      "#   Card B: 6 or 5",
      "#   Card C: 9 or 1",
      "#   Card D: 5 or 11",
      "# ============================================================",
      "",
      "import math",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (a) Strategy Card Representation  [3 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "# A strategy card IS a two-level minimax problem without a tree:",
      "#   Level 0 (root)  → MAX node: AI chooses which card to play",
      "#   Level 1         → MIN node: opponent chooses their best response",
      "#   Level 2 (leaf)  → Utility values (game outcomes)",
      "#",
      "# We represent the whole game as a dict:",
      "#   { card_name: [opponent_response_1, opponent_response_2] }",
      "# This flat dict encodes the tree implicitly—no pointers needed.",
      "",
      "GAME = {",
      "    \"Card_A\": [7, 3],",
      "    \"Card_B\": [6, 5],",
      "    \"Card_C\": [9, 1],",
      "    \"Card_D\": [5, 11],",
      "}",
      "",
      "def part_a():",
      "    print(\"(a) Strategy card representation\")",
      "    print(\"    Each card  → MAX decision node (AI chooses a card)\")",
      "    print(\"    Responses  → MIN leaf values  (opponent minimises)\")",
      "    print()",
      "    print(f\"    {'Card':<10} {'Responses':<16} Modelled as …\")",
      "    print(f\"    {'─'*10} {'─'*16} {'─'*30}\")",
      "    for card, resp in GAME.items():",
      "        print(f\"    {card:<10} {str(resp):<16} MAX→MIN→leaf\")",
      "    print()",
      "    print(\"    No explicit tree structure is required because\")",
      "    print(\"    the two-level card/response table IS the minimax tree.\")",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (b) Optimal MIN-player response for each card  [4 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "# The MIN player always picks the response with the lowest value.",
      "",
      "def part_b() -> dict:",
      "    print(\"\\n(b) Optimal opponent (MIN) move per card\")",
      "    print(f\"    {'Card':<10} {'Responses':<14} MIN picks   Justification\")",
      "    print(f\"    {'─'*10} {'─'*14} {'─'*12} {'─'*26}\")",
      "",
      "    min_values = {}",
      "    for card, resp in GAME.items():",
      "        chosen = min(resp)",
      "        idx    = resp.index(chosen) + 1",
      "        other  = [v for v in resp if v != chosen][0]",
      "        min_values[card] = chosen",
      "        print(f\"    {card:<10} {str(resp):<14} {chosen} (R{idx})       \"",
      "              f\"{chosen} < {other} → minimises AI score\")",
      "",
      "    return min_values",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (c) AI (MAX) selects the best strategy card  [4 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "# After each MIN node resolves to its minimum value, the MAX",
      "# player picks the card whose MIN-value is highest.",
      "",
      "def part_c(min_values: dict) -> tuple:",
      "    print(\"\\n(c) AI (MAX) selects best strategy card\")",
      "    print(f\"    Guaranteed values after opponent plays optimally: {min_values}\")",
      "",
      "    best_card = max(min_values, key=min_values.get)",
      "    best_val  = min_values[best_card]",
      "",
      "    for card, val in min_values.items():",
      "        marker = \" ← MAX picks this\" if card == best_card else \"\"",
      "        print(f\"    {card}: {val}{marker}\")",
      "",
      "    return best_card, best_val",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (d) Guaranteed payoff (utility value)  [2 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "",
      "def part_d(best_card: str, best_val: int):",
      "    print(\"\\n(d) Final guaranteed payoff\")",
      "    print(f\"    AI plays {best_card}  →  guaranteed utility = {best_val}\")",
      "    print(\"    This is the minimax value of the root node.\")",
      "    print(\"    No matter what the opponent does, AI scores ≥ this.\")",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (e) Assumption + real-world limitation  [2 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "",
      "def part_e():",
      "    print(\"\\n(e) Optimality assumption & limitation\")",
      "    print(\"\"\"",
      "    ASSUMPTION",
      "    ──────────",
      "    Minimax assumes the opponent ALWAYS plays optimally—choosing",
      "    the move that minimises the AI's score at every decision node.",
      "    This gives the AI a provable worst-case guarantee.",
      "",
      "    WHY USEFUL",
      "    ──────────",
      "    Even if the opponent makes mistakes, the AI still achieves at",
      "    least its guaranteed utility value. It is a safe lower bound.",
      "",
      "    LIMITATION IN REAL-WORLD AI",
      "    ───────────────────────────",
      "    Real opponents are NOT always optimal. They may:",
      "      • Make mistakes or play randomly",
      "      • Have incomplete information about the game state",
      "      • Have mixed objectives (not purely minimising AI's score)",
      "      • Be constrained by time or computation limits",
      "",
      "    Treating a sub-optimal opponent as always-optimal makes the AI",
      "    unnecessarily conservative—it may miss higher expected-value",
      "    moves. Alternatives: Expectimax (models probabilistic play),",
      "    Monte Carlo Tree Search, or explicit opponent modelling.",
      "\"\"\")",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# Full Minimax + Alpha-Beta Pruning trace",
      "# ──────────────────────────────────────────────────────────────",
      "",
      "def minimax_ab(node, is_max, alpha, beta, depth, path, trace=True):",
      "    \"\"\"",
      "    Minimax with alpha-beta pruning.",
      "    node : int (leaf) or dict (internal node)",
      "    is_max: True = MAX turn, False = MIN turn",
      "    \"\"\"",
      "    indent = \"  \" * depth",
      "    label  = \"MAX\" if is_max else \"MIN\"",
      "",
      "    # ── Leaf node ──",
      "    if isinstance(node, int):",
      "        if trace:",
      "            print(f\"{indent}Leaf  [{path}] = {node}\")",
      "        return node",
      "",
      "    best = -math.inf if is_max else math.inf",
      "",
      "    for child_name, child_node in node.items():",
      "        val = minimax_ab(child_node, not is_max, alpha, beta,",
      "                         depth + 1, child_name, trace)",
      "        if is_max:",
      "            best  = max(best, val)",
      "            alpha = max(alpha, best)",
      "        else:",
      "            best = min(best, val)",
      "            beta = min(beta, best)",
      "",
      "        if trace:",
      "            print(f\"{indent}{label} [{path}] after {child_name}: \"",
      "                  f\"best={best}  α={alpha:.0f}  β={beta:.0f}\")",
      "",
      "        if beta <= alpha:",
      "            if trace:",
      "                print(f\"{indent}  ✂  Alpha-Beta PRUNE \"",
      "                      f\"(β={beta:.0f} ≤ α={alpha:.0f}), skip remaining children\")",
      "            break",
      "",
      "    return best",
      "",
      "",
      "def run_alpha_beta():",
      "    print(\"\\n── Alpha-Beta Pruning full trace ─────────────────────\")",
      "    print(\"   (β ≤ α triggers pruning; pruned branches shown with ✂)\\n\")",
      "",
      "    # Build nested dict for generic recursion",
      "    tree = {\"ROOT\": {}}",
      "    for card, responses in GAME.items():",
      "        tree[\"ROOT\"][card] = {f\"R{i+1}_{v}\": v",
      "                              for i, v in enumerate(responses)}",
      "",
      "    root_val = minimax_ab(tree[\"ROOT\"], True,",
      "                          -math.inf, math.inf, 0, \"ROOT\")",
      "    print(f\"\\n   Minimax root value (with pruning) = {root_val}\")",
      "",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# Main",
      "# ──────────────────────────────────────────────────────────────",
      "",
      "def main():",
      "    sep = \"=\" * 56",
      "    print(sep)",
      "    print(\"  Q2 Minimax + Alpha-Beta Pruning (Combat AI)\")",
      "    print(sep)",
      "",
      "    part_a()",
      "    min_values          = part_b()",
      "    best_card, best_val = part_c(min_values)",
      "    part_d(best_card, best_val)",
      "    part_e()",
      "    run_alpha_beta()",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
    ]
  },
