      "# ============================================================",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (a) Variables  [4 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "# Each variable represents a presentation that needs a time slot.",
      "",
      "variables = [\"T1_ML\", \"T2_Robotics\", \"T3_NLP\", \"T4_CompVision\", \"T5_ReinfLearn\"]",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (b) Domains  [4 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "# Every presentation can initially be placed in any of the 5 slots.",
      "",
      "domains = {var: [1, 2, 3, 4, 5] for var in variables}",
      "",
      "slot_names = {",
      "    1: \"Slot 1 | 9:00 10:00 AM\",",
      "    2: \"Slot 2 | 10:00 11:00 AM\",",
      "    3: \"Slot 3 | 11:00 12:00 PM\",",
      "    4: \"Slot 4 | 2:00 3:00 PM\",",
      "    5: \"Slot 5 | 3:00 4:00 PM\",",
      "}",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (c) Constraints (Unary + Binary)  [8 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "",
      "# C1 (Binary): T1 and T3 must NOT be in consecutive slots",
      "def c1_not_consecutive(a):",
      "    if \"T1_ML\" in a and \"T3_NLP\" in a:",
      "        return abs(a[\"T1_ML\"] - a[\"T3_NLP\"]) != 1",
