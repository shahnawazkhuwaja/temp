      "ax.set_xlabel(\"Country\")",
      "ax.set_ylabel(\"Total Revenue (£)\")",
      "ax.tick_params(axis=\"x\", rotation=35)",
      "plt.tight_layout()",
      "plt.savefig(\"step7_country_sales.png\", dpi=100)",
      "plt.close()",
      "print(\"\\n[Step 7] Country sales chart saved → step7_country_sales.png\")",
      "print(country_sales.to_string())",
      "",
      "# ── Step 8: Top-selling products by quantity  [1 Mark] ───────",
      "top_products = (",
      "    df.groupby(\"StockCode\")[\"Quantity\"]",
      "    .sum()",
      "    .sort_values(ascending=False)",
      "    .head(10)",
      ")",
      "fig, ax = plt.subplots(figsize=(9, 4))",
      "top_products.plot(kind=\"bar\", ax=ax, color=\"coral\", edgecolor=\"white\")",
      "ax.set_title(\"Top 10 Best-Selling Products by Quantity\")",
      "ax.set_xlabel(\"StockCode\")",
      "ax.set_ylabel(\"Total Quantity Sold\")",
      "ax.tick_params(axis=\"x\", rotation=0)",
      "plt.tight_layout()",
      "plt.savefig(\"step8_top_products.png\", dpi=100)",
      "plt.close()",
      "print(\"\\n[Step 8] Top products chart saved → step8_top_products.png\")",
      "print(top_products.to_string())",
      "",
      "# ── Step 9: Monthly sales trend  [1 Mark] ────────────────────",
      "monthly_sales = df.groupby(\"Month\")[\"TotalPrice\"].sum()",
      "fig, ax = plt.subplots(figsize=(10, 4))",
      "monthly_sales.plot(kind=\"line\", marker=\"o\", color=\"green\", ax=ax)",
      "ax.set_title(\"Monthly Sales Trend\")",
      "ax.set_xlabel(\"Month (1 = January)\")",
      "ax.set_ylabel(\"Total Revenue (£)\")",
      "ax.set_xticks(range(1, 13))",
      "plt.tight_layout()",
      "plt.savefig(\"step9_monthly_trend.png\", dpi=100)",
      "plt.close()",
      "print(\"\\n[Step 9] Monthly trend chart saved → step9_monthly_trend.png\")",
      "",
      "# ── Step 10: Transactions per customer  [1 Mark] ─────────────",
      "cust_txn = (",
      "    df[df[\"CustomerID\"] != 0]",
      "    .groupby(\"CustomerID\")[\"InvoiceNo\"]",
      "    .nunique()",
      ")",
      "print(f\"\\n[Step 10] Transactions per customer:\")",
      "print(f\"          Mean   : {cust_txn.mean():.2f}\")",
      "print(f\"          Median : {cust_txn.median():.0f}\")",
      "print(f\"          Max    : {cust_txn.max()}\")",
      "print(f\"          Customers with 5+ invoices: {(cust_txn >= 5).sum()}\")",
      "",
      "",
      "# ══════════════════════════════════════════════════════════════",
      "# PART 2 MODEL TRAINING AND EVALUATION (K-MEANS CLUSTERING)",
      "# ══════════════════════════════════════════════════════════════",
      "",
      "print(\"\\n\" + \"=\" * 56)",
      "print(\"  PART 2 Model Training and Evaluation\")",
      "print(\"=\" * 56)",
      "",
      "# ── Step 1: Customer-level aggregated features  [1 Mark] ─────",
      "cust_df = (",
      "    df[df[\"CustomerID\"] != 0]",
      "    .groupby(\"CustomerID\")",
      "    .agg(",
      "        TotalSpend    =(\"TotalPrice\",  \"sum\"),",
      "        PurchaseFreq  =(\"InvoiceNo\",   \"nunique\"),",
      "        TotalQuantity =(\"Quantity\",    \"sum\"),",
      "    )",
      "    .reset_index()",
      ")",
      "print(f\"\\n[Part2-Step1] Customer-level dataset: {cust_df.shape}\")",
      "print(cust_df.describe().to_string())",
      "",
      "# ── Step 2: Train / test split (80/20)  [1 Mark] ─────────────",
      "X = cust_df[[\"TotalSpend\", \"PurchaseFreq\", \"TotalQuantity\"]]",
      "X_train, X_test = train_test_split(X, test_size=0.2, random_state=42)",
      "print(f\"\\n[Part2-Step2] Train: {X_train.shape}  Test: {X_test.shape}\")",
      "",
      "# ── Step 3: Feature scaling (standardisation)  [1 Mark] ──────",
      "scaler        = StandardScaler()",
      "X_train_sc    = scaler.fit_transform(X_train)   # fit on train only",
      "X_test_sc     = scaler.transform(X_test)        # apply same scale to test",
      "print(\"[Part2-Step3] Features standardised (mean=0, std=1) ✓\")",
      "",
      "# ── Step 4 & 5: K-Means + Elbow Method  [1+1 Marks] ─────────",
      "inertias  = []",
      "sil_scores = []",
      "K_RANGE   = range(2, 11)",
      "",
      "print(\"\\n[Part2-Step5] Elbow method (WCSS vs K):\")",
      "for k in K_RANGE:",
      "    km = KMeans(n_clusters=k, random_state=42, n_init=10)",
      "    km.fit(X_train_sc)",
      "    inertias.append(km.inertia_)",
      "    sil = silhouette_score(X_train_sc, km.labels_)",
      "    sil_scores.append(sil)",
      "    print(f\"  K={k}: WCSS={km.inertia_:,.1f}  Silhouette={sil:.3f}\")",
      "",
      "# Plot elbow",
      "fig, axes = plt.subplots(1, 2, figsize=(12, 4))",
      "axes[0].plot(list(K_RANGE), inertias, \"bo-\")",
      "axes[0].set_title(\"Elbow Method – WCSS vs K\")",
      "axes[0].set_xlabel(\"K (number of clusters)\")",
      "axes[0].set_ylabel(\"Inertia (WCSS)\")",
      "",
      "axes[1].plot(list(K_RANGE), sil_scores, \"rs-\")",
      "axes[1].set_title(\"Silhouette Score vs K\")",
      "axes[1].set_xlabel(\"K (number of clusters)\")",
      "axes[1].set_ylabel(\"Silhouette Score\")",
      "",
      "plt.tight_layout()",
      "plt.savefig(\"elbow_method.png\", dpi=100)",
      "plt.close()",
      "print(\"         Elbow chart saved → elbow_method.png\")",
      "",
      "BEST_K = 3   # ← Inspect elbow_method.png and adjust this value",
      "print(f\"\\n         Selected K = {BEST_K}  (review chart to confirm)\")",
      "",
      "# ── Step 4: Fit final K-Means model  [1 Mark] ────────────────",
      "kmeans = KMeans(n_clusters=BEST_K, random_state=42, n_init=10)",
      "kmeans.fit(X_train_sc)",
      "print(f\"[Part2-Step4] K-Means fitted with K={BEST_K} ✓\")",
      "",
      "# ── Step 6: Assign labels & store centroids  [1 Mark] ────────",
      "X_train = X_train.copy()",
      "X_train[\"Cluster\"]   = kmeans.labels_",
      "centroids_scaled     = kmeans.cluster_centers_",
      "centroids_original   = scaler.inverse_transform(centroids_scaled)",
      "",
      "print(\"\\n[Part2-Step6] Cluster centroids (original scale):\")",
      "centroid_df = pd.DataFrame(",
      "    centroids_original,",
      "    columns=[\"TotalSpend\", \"PurchaseFreq\", \"TotalQuantity\"]",
      ")",
      "centroid_df.index.name = \"Cluster\"",
      "print(centroid_df.round(2).to_string())",
      "",
      "print(\"\\n         Training cluster distribution:\")",
      "print(X_train[\"Cluster\"].value_counts().sort_index().to_string())",
      "",
      "# ── Step 7: Predict cluster labels for test set  [1 Mark] ────",
      "X_test = X_test.copy()",
      "X_test[\"Cluster\"] = kmeans.predict(X_test_sc)",
      "print(\"\\n[Part2-Step7] Test cluster labels assigned ✓\")",
      "",
      "# ── Step 8: Compare train vs test distributions  [1 Mark] ────",
      "print(\"\\n[Part2-Step8] Cluster distribution comparison:\")",
      "train_dist = X_train[\"Cluster\"].value_counts(normalize=True).sort_index()",
      "test_dist  = X_test[\"Cluster\"].value_counts(normalize=True).sort_index()",
      "",
      "compare_df = pd.DataFrame({\"Train (%)\": train_dist * 100,",
      "                            \"Test  (%)\": test_dist  * 100}).round(1)",
      "print(compare_df.to_string())",
      "",
      "sil_train = silhouette_score(X_train_sc, kmeans.labels_)",
      "sil_test  = silhouette_score(X_test_sc,  kmeans.predict(X_test_sc))",
      "print(f\"\\n         Silhouette – Train: {sil_train:.3f}  Test: {sil_test:.3f}\")",
      "delta = abs(sil_train - sil_test)",
      "if delta < 0.05:",
      "    print(\"         → Scores close: clustering is CONSISTENT across sets ✓\")",
      "else:",
      "    print(f\"         → Gap = {delta:.3f}: possible overfitting – increase K or data.\")",
      "",
      "# ── Step 9: Visualise clusters with PCA  [1 Mark] ────────────",
      "pca     = PCA(n_components=2, random_state=42)",
      "train2d = pca.fit_transform(X_train_sc)",
      "test2d  = pca.transform(X_test_sc)",
      "",
      "print(f\"\\n[Part2-Step9] PCA explained variance: \"",
      "      f\"{pca.explained_variance_ratio_.sum()*100:.1f}%\")",
      "",
      "fig, axes = plt.subplots(1, 2, figsize=(13, 5))",
      "cmap = \"viridis\"",
      "",
      "for ax, data2d, labels, title in [",
      "    (axes[0], train2d, X_train[\"Cluster\"].values, f\"Training Clusters  (K={BEST_K}, PCA)\"),",
      "    (axes[1], test2d,  X_test[\"Cluster\"].values,  f\"Test Clusters      (K={BEST_K}, PCA)\"),",
      "]:",
      "    sc = ax.scatter(data2d[:, 0], data2d[:, 1],",
      "                    c=labels, cmap=cmap, alpha=0.65, s=28, edgecolors=\"none\")",
      "    ax.set_title(title)",
      "    ax.set_xlabel(f\"PC1 ({pca.explained_variance_ratio_[0]*100:.1f}%)\")",
      "    ax.set_ylabel(f\"PC2 ({pca.explained_variance_ratio_[1]*100:.1f}%)\")",
      "    plt.colorbar(sc, ax=ax, label=\"Cluster\")",
      "",
      "plt.tight_layout()",
      "plt.savefig(\"clusters_pca.png\", dpi=100)",
      "plt.close()",
      "print(\"         PCA cluster plot saved → clusters_pca.png\")",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# Summary",
      "# ──────────────────────────────────────────────────────────────",
      "print(\"\\n\" + \"=\" * 56)",
      "print(\"  All steps complete. Generated files:\")",
      "print(\"    step7_country_sales.png\")",
      "print(\"    step8_top_products.png\")",
      "print(\"    step9_monthly_trend.png\")",
      "print(\"    elbow_method.png\")",
      "print(\"    clusters_pca.png\")",
      "print(\"=\" * 56)"
    ]
  },
