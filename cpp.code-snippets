      "            result = backtrack(assignment, variables, domains, depth + 1)",
      "            if result is not None:",
      "                return result",
      "        else:",
      "            print(f\"{indent}  ✗ constraint violation, backtracking\")",
      "        del assignment[var]",
      "",
      "    return None   # trigger backtrack to caller",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# Main run everything",
      "# ──────────────────────────────────────────────────────────────",
      "def main():",
      "    sep = \"=\" * 56",
