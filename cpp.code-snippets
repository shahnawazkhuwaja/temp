      "    print(\"└──────────────────────────────────────────────────────┘\")",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (e) Backtracking Search  [5 Marks]",
      "# ──────────────────────────────────────────────────────────────",
      "",
      "def is_consistent(assignment):",
      "    return all(c(assignment) for c in constraints)",
      "",
      "def backtrack(assignment, variables, domains, depth=0):",
      "    \"\"\"",
      "    Recursive backtracking with MRV (Minimum Remaining Values) heuristic.",
      "    Returns a complete valid assignment or None.",
      "    \"\"\"",
      "    if len(assignment) == len(variables):",
      "        return assignment                       # solution found",
      "",
      "    # MRV heuristic: pick the variable with the fewest legal values",
      "    unassigned = [v for v in variables if v not in assignment]",
      "    var = min(unassigned, key=lambda v: len(domains[v]))",
      "",
      "    indent = \"  \" * depth",
