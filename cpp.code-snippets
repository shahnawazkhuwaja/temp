  "Alpha Beta": {
    "prefix": "alphabeta",
    "body": [
      "import math",
      "",
      "def alphabeta(depth, index, alpha, beta, isMax, values, max_depth):",
      "    if depth == max_depth:",
      "        return values[index]",
      "",
      "    if isMax:",
      "        best = -math.inf",
      "        for i in range(2):",
      "            val = alphabeta(depth + 1, index * 2 + i, alpha, beta, False, values, max_depth)",
      "            best = max(best, val)",
      "            alpha = max(alpha, best)",
      "            if beta <= alpha:",
      "                break",
      "        return best",
      "    else:",
      "        best = math.inf",
      "        for i in range(2):",
      "            val = alphabeta(depth + 1, index * 2 + i, alpha, beta, True, values, max_depth)",
      "            best = min(best, val)",
      "            beta = min(beta, best)",
      "            if beta <= alpha:",
      "                break",
      "        return best",
      "",
      "def main():",
      "    values = [2, 3, 5, 9, 0, 1, 7, 5]",
      "    max_depth = 3",
      "    result = alphabeta(0, 0, -math.inf, math.inf, True, values, max_depth)",
      "    print(\"Optimal Value:\", result)",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
    ],
