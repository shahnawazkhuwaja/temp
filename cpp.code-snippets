      "",
      "# C2 (Binary): T2 must be scheduled BEFORE T4",
      "def c2_robotics_before_vision(a):",
      "    if \"T2_Robotics\" in a and \"T4_CompVision\" in a:",
      "        return a[\"T2_Robotics\"] < a[\"T4_CompVision\"]",
      "    return True",
      "",
      "# C3 (Unary): T5 cannot be in Slot 1 or Slot 2 (speaker unavailable mornings)",
      "def c3_reinforcement_not_morning(a):",
      "    if \"T5_ReinfLearn\" in a:",
      "        return a[\"T5_ReinfLearn\"] not in [1, 2]",
      "    return True",
      "",
      "# C4 (Binary): T3 must be scheduled AFTER T1 (demo dependency)",
      "def c4_nlp_after_ml(a):",
      "    if \"T1_ML\" in a and \"T3_NLP\" in a:",
      "        return a[\"T3_NLP\"] > a[\"T1_ML\"]",
      "    return True",
      "",
      "# C5 (Unary): T4 can only go in Slot 1 or Slot 2 (high-attendance requirement)",
      "def c5_vision_morning_only(a):",
      "    if \"T4_CompVision\" in a:",
      "        return a[\"T4_CompVision\"] in [1, 2]",
      "    return True",
      "",
      "# C6 (Resource): Slot 3 is reserved exclusively for T1 or T2",
      "def c6_slot3_reserved(a):",
      "    for var, slot in a.items():",
      "        if slot == 3 and var not in [\"T1_ML\", \"T2_Robotics\"]:",
      "            return False",
      "    return True",
      "",
      "# C7 (Global): All presentations must be in different slots (alldiff)",
      "def c7_all_different(a):",
      "    slots = list(a.values())",
      "    return len(slots) == len(set(slots))",
      "",
      "constraints = [",
      "    c1_not_consecutive,",
      "    c2_robotics_before_vision,",
      "    c3_reinforcement_not_morning,",
      "    c4_nlp_after_ml,",
      "    c5_vision_morning_only,",
      "    c6_slot3_reserved,",
      "    c7_all_different,",
      "]",
      "",
      "constraint_labels = [",
      "    \"C1: T1 and T3 not in consecutive slots (binary)\",",
      "    \"C2: T2 slot# < T4 slot# (binary)\",",
      "    \"C3: T5 not in Slot 1 or 2 (unary)\",",
      "    \"C4: T3 slot# > T1 slot# (binary)\",",
      "    \"C5: T4 only in Slot 1 or 2 (unary)\",",
      "    \"C6: Slot 3 reserved for T1 or T2 (resource)\",",
      "    \"C7: All slots distinct alldiff (global)\",",
      "]",
      "",
      "# ──────────────────────────────────────────────────────────────",
      "# (d) Constraint Graph",
      "# ──────────────────────────────────────────────────────────────",
      "# Nodes  = presentations (variables)",
      "# Edges  = shared binary constraints",
      "# Unary constraints are listed separately (they affect only one node)",
      "",
      "constraint_graph = {",
      "    \"T1_ML\":         [\"T3_NLP (C1,C4)\"],",
      "    \"T2_Robotics\":   [\"T4_CompVision (C2)\"],",
      "    \"T3_NLP\":        [\"T1_ML (C1,C4)\"],",
      "    \"T4_CompVision\": [\"T2_Robotics (C2)\"],",
      "    \"T5_ReinfLearn\": [],            # only unary constraint C3",
      "}",
      "unary_constraints = {",
      "    \"T5_ReinfLearn\": \"C3 – not Slot 1 or 2\",",
      "    \"T4_CompVision\": \"C5 – only Slot 1 or 2\",",
      "}",
      "",
      "def print_constraint_graph():",
      "    print(\"\\n┌─ Constraint Graph (Adjacency List) ─────────────────┐\")",
      "    for node, neighbors in constraint_graph.items():",
      "        print(f\"│  {node:<20} → {neighbors}\")",
      "    print(\"│\")",
      "    print(\"│  Unary constraints:\")",
      "    for node, desc in unary_constraints.items():",
