      "try:",
      "    df = pd.read_csv(CSV_PATH, encoding=\"ISO-8859-1\")",
      "    print(f\"[Step 1] Loaded '{CSV_PATH}': {df.shape[0]:,} rows × {df.shape[1]} cols\")",
      "except FileNotFoundError:",
      "    print(f\"[Step 1] '{CSV_PATH}' not found – using synthetic data.\")",
      "    df = make_synthetic_data()",
      "    print(f\"         Synthetic dataset: {df.shape[0]:,} rows × {df.shape[1]} cols\")",
      "",
      "print(\"\\n── Shape:\", df.shape)",
      "print(\"── dtypes:\\n\", df.dtypes.to_string())",
      "print(\"\\n── First 5 rows:\\n\", df.head().to_string())",
      "print(\"\\n── Summary statistics:\\n\", df.describe(include=\"all\").to_string())",
      "",
      "# ── Step 2: Handle missing values  [1 Mark] ──────────────────",
      "print(\"\\n[Step 2] Missing values BEFORE:\")",
      "print(df.isnull().sum().to_string())",
      "",
      "df[\"CustomerID\"].fillna(0, inplace=True)          # 0  = anonymous customer",
      "df[\"Description\"].fillna(\"Unknown\", inplace=True) # readable placeholder",
      "",
      "print(\"\\n         Missing values AFTER:\")",
      "print(df.isnull().sum().to_string())",
      "",
      "# ── Step 3: Remove invalid transactions  [1 Mark] ────────────",
      "rows_before = len(df)",
      "df = df[df[\"Quantity\"]  > 0]   # drop returns / errors (negative qty)",
      "df = df[df[\"UnitPrice\"] > 0]   # drop zero / negative prices",
      "print(f\"\\n[Step 3] Removed {rows_before - len(df):,} invalid rows. \"",
      "      f\"{len(df):,} valid rows remain.\")",
      "",
      "# ── Step 4: Parse InvoiceDate + extract features  [1 Mark] ───",
      "df[\"InvoiceDate\"] = pd.to_datetime(",
      "    df[\"InvoiceDate\"], dayfirst=True, errors=\"coerce\"",
      ")",
      "df[\"Month\"]   = df[\"InvoiceDate\"].dt.month",
      "df[\"Weekday\"] = df[\"InvoiceDate\"].dt.dayofweek  # 0 = Monday",
      "df[\"Hour\"]    = df[\"InvoiceDate\"].dt.hour",
      "print(\"\\n[Step 4] DateTime features added: Month, Weekday, Hour ✓\")",
      "print(df[[\"InvoiceDate\", \"Month\", \"Weekday\", \"Hour\"]].head(3).to_string())",
      "",
      "# ── Step 5: Create TotalPrice feature  [1 Mark] ──────────────",
      "df[\"TotalPrice\"] = df[\"Quantity\"] * df[\"UnitPrice\"]",
      "print(f\"\\n[Step 5] TotalPrice = Quantity × UnitPrice ✓\")",
      "print(f\"         Mean: £{df['TotalPrice'].mean():.2f}  \"",
      "      f\"Max: £{df['TotalPrice'].max():.2f}\")",
      "",
      "# ── Step 6: Detect & treat outliers – IQR method  [1 Mark] ───",
      "",
      "def remove_outliers_iqr(df: pd.DataFrame, col: str) -> pd.DataFrame:",
      "    Q1, Q3 = df[col].quantile([0.25, 0.75])",
      "    IQR     = Q3 - Q1",
      "    lo, hi  = Q1 - 1.5 * IQR, Q3 + 1.5 * IQR",
      "    before  = len(df)",
      "    df      = df[(df[col] >= lo) & (df[col] <= hi)]",
      "    print(f\"  {col:<12}: removed {before - len(df):>4} outliers \"",
      "          f\"  bounds [{lo:.2f}, {hi:.2f}]\")",
      "    return df",
      "",
      "print(\"\\n[Step 6] Outlier removal (IQR):\")",
      "df = remove_outliers_iqr(df, \"Quantity\")",
      "df = remove_outliers_iqr(df, \"UnitPrice\")",
      "df.reset_index(drop=True, inplace=True)",
      "",
      "# ── Step 7: Sales distribution by country  [1 Mark] ──────────",
      "country_sales = (",
      "    df.groupby(\"Country\")[\"TotalPrice\"]",
